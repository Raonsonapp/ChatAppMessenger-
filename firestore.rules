rules_version = '2';

// Қоидаҳои пешина `allow read, write: if request.auth != null` буданд — яъне
// ҲАР корбари воридшуда метавонист паёмҳои ҳамаро бихонад, нависад ва нест
// кунад. Азбаски сабти ном барои ҳама кушода аст, ин маънои онро дошт, ки
// чатҳо умуман махфӣ набуданд.
//
// Қоидаҳои зерин дастрасиро ба он чизе маҳдуд мекунанд, ки худи барнома
// воқеан истифода мебарад.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Профилҳо: ҳама мебинанд (барои ёфтани контактҳо), вале ҳар кас танҳо
    // профили худро тағйир дода метавонад.
    match /users/{userId} {
      allow read: if signedIn();

      // Майдони `plus` (ҳуқуқи ChatApp Plus) барои барнома ХОНДАНӢ аст.
      //
      // Ин муҳимтарин қоидаи Plus аст: агар барнома тавонад `plus.active`-ро
      // худаш нависад, обунаи пулакӣ бо як сатри код гирифта мешавад. Онро
      // танҳо сервер бо Admin SDK менависад — он аз қоидаҳо намегузарад.
      //
      // Барнома `set(merge: true)` зиёд истифода мебарад; дар ин ҳолат
      // `request.resource.data` натиҷаи омехта аст, бинобар ин `plus` он ҷо
      // ҳаст ва ба қимати ҳозира баробар мемонад — навиштанҳои муқаррарӣ
      // бетаъсир мемонанд.
      allow create: if signedIn() && uid() == userId
        && !('plus' in request.resource.data);
      allow update: if signedIn() && uid() == userId
        && request.resource.data.get('plus', null) == resource.data.get('plus', null);
      allow delete: if signedIn() && uid() == userId;

      // Паёмҳои ситорадор — танҳо барои худи соҳиб. Қоидаҳои ҳуҷҷати падар ба
      // зерколлексия татбиқ намешаванд, бинобар ин ин ҷо алоҳида навишта шуд.
      match /starred/{starId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // Дафтари бизнес — маълумоти хеле шахсӣ: кӣ ба ман чанд қарздор аст.
      // Танҳо соҳиб мехонад ва менависад. Харидор онро ҳељ гоҳ намебинад.
      match /ledger/{entryId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // Дастгоҳҳои пайваст — танҳо худи соҳиби ҳисоб мебинад ва идора мекунад.
      // Ҳеҷ корбари дигар набояд донад ки шумо аз кадом дастгоҳҳо медароед.
      match /devices/{deviceId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // Номҳои ягонаи корбар (`@username`).
    //
    // ID-и ҳуҷҷат худи номи хурдҳарф аст — ҳамин ягонагиро таъмин мекунад.
    // Гирифтани номи озод ба ҳар воридшуда иҷозат аст, вале ҳуҷҷати мавҷударо
    // танҳо соҳибаш иваз ё нест карда метавонад — бинобар ин касе номи
    // дигареро рабуда наметавонад.
    //
    // `update` барои соҳиб лозим аст: агар навиштан ба `users/{uid}.username`
    // ноком монад, ҳуҷҷати ном аллакай ҳаст ва корбар бояд тавонад онро аз нав
    // тасдиқ кунад. Бе ин ӯ номи худашро дигар гирифта наметавонист.
    // Эмулятор маҳз ҳамин ҳолатро гирифт.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == uid();
      allow update: if signedIn()
        && resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // Эълонҳои Бозор: маҳсулот, хизмат, ҷойи кор ва эълон.
    //
    // Эълон ҷамъиятӣ аст — ҳар воридшуда онро мехонад, вагарна Бозор маъно
    // надорад. Вале навиштан, тағйир ва нест кардан танҳо аз соҳиб:
    // - `ownerId` бояд худи нависанда бошад, то касе эълонро ба номи каси
    //   дигар нагузорад;
    // - ҳангоми тағйир `ownerId` бетағйир мемонад, то эълони каси дигар рабуда
    //   нашавад.
    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200;
      allow update: if signedIn()
        && resource.data.ownerId == uid()
        && request.resource.data.ownerId == uid();
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    // Сӯҳбати шахсӣ: танҳо ду иштирокчӣ.
    match /conversations/{conversationId} {
      allow read, update, delete: if signedIn()
        && uid() in resource.data.participants;
      allow create: if signedIn()
        && uid() in request.resource.data.participants;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function isParticipant() {
          return uid() in conversation().participants;
        }
        // Дар сӯҳбати шахсӣ ҳамеша ду иштирокчӣ ҳаст.
        function otherParticipant() {
          return conversation().participants[0] == uid()
            ? conversation().participants[1]
            : conversation().participants[0];
        }
        // Манъкунӣ бояд ду тарафа бошад. Пештар он танҳо дар экран буд:
        // манъшуда ба ҳар ҳол паём фиристода метавонист, зеро қоида инро
        // намесанҷид — яъне «манъ кардан» аз чизе ҳимоя намекард.
        function notBlockedByOther() {
          return !(uid() in get(
            /databases/$(database)/documents/users/$(otherParticipant())
          ).data.get('blockedUsers', []));
        }

        /// Танҳо худро ба рӯйхати додашуда илова мекунад.
        ///
        /// Бе ин маҳдудият гиранда метавонист ҳангоми қайди «хонда шуд»
        /// матни паёмро низ иваз кунад.
        function onlyAddsSelf(fields) {
          return request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(fields)
            && request.resource.data.get('deliveredTo', [])
                 .removeAll(resource.data.get('deliveredTo', [])).hasOnly([uid()])
            && request.resource.data.get('readBy', [])
                 .removeAll(resource.data.get('readBy', [])).hasOnly([uid()]);
        }

        function changesOnly(fields) {
          return request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(fields);
        }

        allow read: if signedIn() && isParticipant();
        allow create: if signedIn() && isParticipant() && notBlockedByOther();

        allow update: if signedIn() && isParticipant() && (
          // Соҳиби паём онро тағйир дода метавонад.
          resource.data.senderId == uid()
          // Гиранда худро ҳамчун «расид»/«хонда» қайд мекунад.
          || onlyAddsSelf(['deliveredTo', 'readBy', 'read'])
          // Аксуламал, овоз дар пурсиш, пинҳон кардан барои худам.
          || changesOnly(['reactions'])
          || changesOnly(['pollVotes'])
          || changesOnly(['deletedFor'])
        );

        allow delete: if signedIn() && isParticipant();
      }
    }

    // Рамзи даъват ба гурӯҳ. Ҳар корбари воридшуда онро хонда метавонад —
    // вагарна ҳамроҳ шудан бо рамз имконнопазир мешуд; вале сохтан ва нест
    // кардан танҳо аз они администратори ҳамон гурӯҳ аст.
    match /groupInvites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && uid() in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.admins;
      allow delete: if signedIn()
        && uid() in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.admins;
    }

    // Гурӯҳ ва ҷамъият: танҳо аъзоён.
    match /groups/{groupId} {
      allow read: if signedIn() && uid() in resource.data.members;
      // Нест кардани гурӯҳ — танҳо администратор.
      allow delete: if signedIn() && uid() in resource.data.get('admins', []);
      allow create: if signedIn() && uid() in request.resource.data.members;

      function isAdmin() {
        return uid() in resource.data.get('admins', []);
      }
      function touches(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }
      /// Корбар танҳо ХУДашро аз рӯйхати аъзоён мебарорад.
      ///
      /// `size() == 1` ҳатмист: `hasOnly` дар рӯйхати ХОЛӢ ҳамеша рост аст,
      /// бинобар ин бе он ҳар тағйире ки аъзоёнро даст намезанад (масалан
      /// таъин кардани ХУД ҳамчун администратор) «баромадан» ҳисоб мешуд.
      function leavesGroup() {
        return touches(['members', 'memberNames', 'admins', 'unread'])
          && resource.data.members.removeAll(request.resource.data.members).size() == 1
          && resource.data.members.removeAll(request.resource.data.members).hasOnly([uid()])
          && request.resource.data.members.removeAll(resource.data.members).size() == 0
          // Администраторҳо танҳо камтар шуда метавонанд — вагарна корбар
          // ҳангоми баромадан худро администратор таъин карда метавонист.
          && request.resource.data.get('admins', [])
               .removeAll(resource.data.get('admins', [])).size() == 0;
      }

      allow update: if signedIn() && (
        // Администратор гурӯҳро идора мекунад.
        (uid() in resource.data.members && isAdmin())

        // Узви оддӣ метавонад БАРОЯД ва ҳисоби нохондаи ХУДашро тағйир
        // диҳад. Пештар ҳар узв метавонист номи гурӯҳ, рӯйхати аъзоён ва
        // ҳатто рӯйхати администраторҳоро иваз кунад — яъне худашро
        // администратор таъин карда, дигаронро бароварда метавонист.
        || (uid() in resource.data.members && leavesGroup())
        || (uid() in resource.data.members && touches(['unread', 'lastMessage',
              'lastMessageType', 'lastMessageName', 'lastMessageTime',
              'lastSenderId', 'archivedBy', 'deletedBy', 'pinnedBy',
              'mutedBy', 'typing']))

        // Ҳамроҳ шудан бо рамзи даъват: корбар танҳо ХУДашро ба рӯйхати
        // аъзоён илова карда метавонад ва танҳо агар гурӯҳ рамзи даъват
        // дошта бошад. Дигар майдонҳоро тағйир дода наметавонад.
        || (
          resource.data.inviteCode != null
          && touches(['members', 'memberNames'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([uid()])
        )
      );

      match /messages/{messageId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.members;

        // Агар гурӯҳ танҳо ба администраторҳо иҷозат диҳад, ин на танҳо дар
        // экран, балки дар худи база низ риоя мешавад.
        allow write: if signedIn()
          && uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && (
            get(/databases/$(database)/documents/groups/$(groupId)).data.onlyAdminsCanSend != true
            || uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
          );
      }
    }

    match /communities/{communityId} {
      allow read, update, delete: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn() && uid() in request.resource.data.members;

      match /messages/{messageId} {
        allow read, write: if signedIn()
          && uid() in get(/databases/$(database)/documents/communities/$(communityId)).data.members;
      }
    }

    // Канал: ҳама мехонанд (кашф ва обуна), вале танҳо соҳиб нашр мекунад.
    // Барои обуна шудан корбар бояд танҳо рӯйхати followers-ро тағйир диҳад.
    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update: if signedIn() && (
        resource.data.ownerId == uid()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
      );
      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == uid();
      }
    }

    // Статус: танҳо соҳиб мегузорад ва нест мекунад. Хондан ба танзимоти
    // махфияти худи соҳиб тобеъ аст — вагарна «Навсозиҳои маро кӣ мебинад»
    // танҳо дар экран менамуд ва дар база риоя намешуд.
    //
    // `contacts` маънои «касе ки бо ман сӯҳбати шахсӣ дорад»-ро дорад. Id-и
    // сӯҳбат аз ду uid сохта мешавад ва тартиби онҳо номаълум аст, бинобар ин
    // ҳар ду вариант тафтиш мешавад.
    // Диққат: аксари корбарон ҳељ гоҳ ин танзимотро намегузоранд, бинобар ин
    // `settings` метавонад умуман набошад. `get(..., default)` ҳамин ҳолатро
    // мебандад — вагарна қоида хато медиҳад ва навсозии ҳама пинҳон мешавад.
    function statusVisibilityOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId))
        .data.get('settings', {})
        .get('statusVisibility', 'everyone');
    }

    function statusVisibleTo(userId) {
      return userId == uid()
        || statusVisibilityOf(userId) == 'everyone'
        || (
          statusVisibilityOf(userId) == 'contacts'
          && (
            exists(/databases/$(database)/documents/conversations/$(userId + '_' + uid()))
            || exists(/databases/$(database)/documents/conversations/$(uid() + '_' + userId))
          )
        );
    }

    match /statuses/{userId} {
      allow read: if signedIn() && statusVisibleTo(userId);
      allow write: if signedIn() && uid() == userId;

      match /items/{itemId} {
        allow read: if signedIn() && statusVisibleTo(userId);
        allow create, delete: if signedIn() && uid() == userId;

        // Ғайр аз соҳиб, бинанда низ бояд худашро ба `viewedBy` илова карда
        // тавонад — вагарна «кӣ дид» ҳељ гоҳ кор намекунад. Иҷозат танҳо ба
        // ҳамин як майдон ва танҳо барои илова кардани uid-и худаш аст.
        allow update: if signedIn() && (
          uid() == userId
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
            && request.resource.data.viewedBy.hasAll(resource.data.viewedBy)
            && request.resource.data.viewedBy.removeAll(resource.data.viewedBy).hasOnly([uid()])
          )
        );
      }
    }

    // Занг: танҳо ду тарафи занг.
    //
    // Диққат: барнома ба `calls` бо ДУ шакли гуногун дархост мефиристад —
    // вкладкаи «Зангҳо» бо `participants arrayContains uid`, вале шунавандаи
    // занги воридотӣ бо `calleeId == uid`. Firestore дархостро танҳо вақте
    // қабул мекунад, ки филтрҳояш қоидаро кафолат диҳанд, бинобар ин ҳар ду
    // ҳолат бояд дар қоида бошанд.
    // Гузоришҳо (шикоят). Корбар менависад, вале ҲЕҶ КАС намехонад:
    // касе набояд бубинад, ки кӣ ба ӯ шикоят кардааст. Модератор онҳоро
    // тавассути консол ё Admin SDK мебинад.
    match /reports/{reportId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.reporterId == uid()
        && request.resource.data.targetId is string
        && request.resource.data.reason is string;
    }

    // Кэши пешнамоиши ҳавола — ҳама мехонанд, менависад ТАНҲО сервер
    // (тавассути Admin SDK, ки қоидаҳоро дур мезанад). Корбар набояд
    // пешнамоиши қалбакӣ гузошта тавонад.
    match /linkPreviews/{key} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Зангҳои банақшагирифташуда — танҳо иштирокчиён.
    match /scheduledCalls/{callId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.participants;
      // Тағйир ва нест кардан — танҳо соҳиб.
      allow update, delete: if signedIn() && resource.data.ownerId == uid();
    }

    match /calls/{callId} {
      allow read: if signedIn() && (
        uid() in resource.data.participants
        || resource.data.calleeId == uid()
        || resource.data.callerId == uid()
      );
      allow update, delete: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn() && uid() in request.resource.data.participants;
    }
  }
}
