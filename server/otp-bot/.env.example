# Токени боти Telegram — аз @BotFather дар Telegram гиред (/newbot).
TELEGRAM_BOT_TOKEN=

# Service Account-и Firebase:
#   1. Firebase Console -> Project Settings -> Service accounts -> Generate new private key
#   2. Тамоми матни файли JSON-и боргирифташударо АЙНАН ба ин ҷо нусхабардорӣ кунед
#      (якҷоя бо { } -и аввалу охир). Дар Railway low value-и мулти-хатта низ кор мекунад.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Ихтиёрӣ — Railway худаш PORT-ро таъмин мекунад.
PORT=3000
