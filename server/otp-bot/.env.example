# Токени боти Telegram — аз @BotFather дар Telegram гиред (/newbot).
TELEGRAM_BOT_TOKEN=

# JSON-и Service Account-и Firebase, ба base64 табдилёфта.
# Тарзи гирифтан:
#   1. Firebase Console -> Project Settings -> Service accounts -> Generate new private key
#   2. Файли JSON-и боргирифташударо ба base64 табдил диҳед:
#      base64 -w0 service-account.json    (Linux/macOS)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Ихтиёрӣ — Railway худаш PORT-ро таъмин мекунад.
PORT=3000
