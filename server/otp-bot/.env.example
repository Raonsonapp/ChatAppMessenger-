# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Firebase Admin service account: paste the complete JSON content.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini API key (optional; keep this secret out of GitHub and the app APK).
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_TRANSLATE_MODEL=gemini-2.5-flash

# Optional media-provider adapters; each endpoint must accept {prompt, durationSeconds?, userId}
# and return JSON with a public HTTPS URL in url, mediaUrl, or output.url.
IMAGE_GENERATION_ENDPOINT=
IMAGE_GENERATION_API_KEY=
VIDEO_GENERATION_ENDPOINT=
VIDEO_GENERATION_API_KEY=
MUSIC_GENERATION_ENDPOINT=
MUSIC_GENERATION_API_KEY=

# Optional translation provider
TRANSLATE_ENDPOINT=
TRANSLATE_API_KEY=

# Optional Agora calling credentials
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Optional owner / storage configuration
OWNER_UID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Locally default to 3000; hosting providers set PORT automatically.
PORT=3000
